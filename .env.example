# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ── AI providers ──────────────────────────────────────────────────
# At least one is required for the AI co-writer (users can also supply
# their own keys in Settings → Brand Voice).
GEMINI_API_KEY=your_gemini_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# OPENAI_API_KEY=your_openai_api_key

# ── Firebase (client SDK — these are public by design) ───────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Meta Marketing API ────────────────────────────────────────────
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback

# ── Access control (required in production) ───────────────────────
# Restrict API routes to your team. Comma-separated. If BOTH are unset, the app
# DENIES all requests in production (still allows in dev). Keep in sync with the
# team allowlist in firestore.rules.
# AUTHORIZED_EMAILS=you@example.com,teammate@example.com
# AUTHORIZED_EMAIL_DOMAINS=yourcompany.com
# Accepts ANY signed-in Google account at the API (including your server AI
# keys). Not a supported public mode — firestore.rules still limit data to the
# team. Leave unset.
# ALLOW_ALL_AUTHENTICATED=true

# ── Video transcode Cloud Function (optional) ─────────────────────
# Large (>50MB) videos route through this GCP function for transcoding.
# VIDEO_TRANSCODE_FUNCTION_URL=https://<region>-<project>.cloudfunctions.net/transcode-and-upload
# TRANSCODE_API_KEY=shared_secret_matching_the_function

# ── Server-side Firestore via Workload Identity Federation ────────
# Lets API routes read/write the server-only Meta token store WITHOUT a
# downloadable service-account key. Required in production (Vercel); locally,
# `gcloud auth application-default login` is used instead. See docs/SETUP.md
# for the one-time GCP + Vercel OIDC setup.
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_PROJECT_NUMBER=000000000000
# GCP_SERVICE_ACCOUNT_EMAIL=mco-admin-sdk@your-gcp-project-id.iam.gserviceaccount.com
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-pool
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel-provider

# ── Misc (optional) ───────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_NAME=campaign-orchestrator   # tags structured log lines
# LOG_LEVEL=info
#
# NOTE: the minimum audience age is a UI setting, not an env var —
# set it in Settings → Ad Setup → Audience Defaults.
